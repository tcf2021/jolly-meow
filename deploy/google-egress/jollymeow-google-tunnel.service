[Unit]
Description=Jolly Meow SSH tunnel to overseas HTTPS egress
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
# This address is the existing jollymeow_outbound Docker gateway, not a public IP.
ExecStart=/usr/bin/ssh -NT -o BatchMode=yes -o IdentitiesOnly=yes -o StrictHostKeyChecking=yes -o UserKnownHostsFile=/etc/jollymeow-google-tunnel/known_hosts -o ExitOnForwardFailure=yes -o ServerAliveInterval=20 -o ServerAliveCountMax=3 -o ConnectTimeout=10 -i /etc/jollymeow-google-tunnel/id_ed25519 -L 172.20.0.1:13843:127.0.0.1:13843 jollymeow-relay@RELAY_HOST
Restart=always
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
MemoryMax=64M
TasksMax=16

[Install]
WantedBy=multi-user.target
